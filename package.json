{
  "name": "yuumotion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npx tsx watch server/src/index.ts",
    "start": "node server/dist/index.js",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json --noEmit && npx esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.js",
    "db:push": "drizzle-kit push",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.119.2",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.2.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-sitemap": "^0.11.0"
  }
}
